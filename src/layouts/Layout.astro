---
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/300-italic.css';
import '@fontsource/inter/400-italic.css';
import Analytics from '@vercel/analytics/astro';
import { APP_VERSION, GITHUB_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 'software' emits the SoftwareApplication node (homepage only); 'webpage' emits a WebPage node that references it instead of duplicating it. */
  schemaType?: 'software' | 'webpage';
}
const {
  title = 'inkwell — Write without distraction.',
  description = 'A local-first markdown editor for macOS, Windows, and Linux. Your notes stay as plain .md files — private, portable, and completely under your control.',
  schemaType = 'software',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const homeURL = new URL('/', Astro.site).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'coros-hq',
  url: homeURL,
  sameAs: [GITHUB_URL],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'inkwell',
  url: homeURL,
  publisher: { '@type': 'Organization', name: 'coros-hq' },
};

// The name is disambiguated from two unrelated same-name entities: Apple's
// discontinued "Inkwell" handwriting feature (Wikipedia: Inkwell (Macintosh))
// and a separate paid product, "Inkwell Markdown Editor" by 4worlds-dev.
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'inkwell',
  alternateName: 'inkwell by coros-hq',
  description,
  url: homeURL,
  operatingSystem: ['macOS', 'Windows', 'Linux'],
  applicationCategory: 'DeveloperApplication',
  softwareVersion: APP_VERSION,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  downloadUrl: `${GITHUB_URL}/releases/latest`,
  publisher: { '@type': 'Organization', name: 'coros-hq', sameAs: GITHUB_URL },
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL.toString(),
  isPartOf: { '@type': 'WebSite', name: 'inkwell', url: homeURL },
  about: { '@type': 'SoftwareApplication', name: 'inkwell', url: homeURL },
};

const pageSchema = schemaType === 'software' ? softwareApplicationSchema : webPageSchema;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="inkwell — Write without distraction." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:           #1C1A17;
    --bg-raised:    #212018;
    --bg-card:      #252219;
    --bg-subtle:    #2D2A22;
    --border:       rgba(255, 255, 255, 0.07);
    --border-mid:   rgba(255, 255, 255, 0.11);
    --accent:       #C4832A;
    --accent-light: #D49840;
    --accent-dim:   rgba(196, 131, 42, 0.15);
    --accent-glow:  rgba(196, 131, 42, 0.07);
    --text:         #F0EDE8;
    --text-2:       #9A8E7E;
    --text-3:       #9A8B79;
    --nav-bg:       rgba(28, 26, 23, 0.88);
    --radius:       10px;
    --radius-lg:    16px;
    --radius-xl:    22px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
    overflow-x: hidden;
  }

  ::selection { background: var(--accent-dim); color: var(--text); }

  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #3A362C; border-radius: 3px; }

  a { color: inherit; text-decoration: none; }

  img, svg { display: block; }
</style>
